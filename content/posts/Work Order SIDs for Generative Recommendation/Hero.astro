---
/**
 * Animated hero for this post: a hierarchical Voronoi tessellation in the
 * visual language of the codebook figure — the RQ-VAE motif rendered as
 * ambient generative art. Lives beside post.md so everything about this
 * hero stays in the post's own folder; the blog page discovers it by
 * convention (see src/pages/blog/[...slug].astro). The static fallback
 * frame (assets/hero_voronoi.png, generated by assets/hero_voronoi.py) is
 * what the `hero` frontmatter field points at.
 *
 * The tessellation itself is STATIC. A handful of cells carry a level-1
 * sub-partition (bold outline, shaded subdivision, its own op dots). Every
 * ~30s ALL selections walk at once: a burst of 3-7 contiguous-neighbor
 * hops each, every hop an instantaneous cut with a 1s beat between hops so
 * the walk is legible. A walker never revisits a cell any walk has already
 * occupied until it has no unvisited neighbor left, in which case it
 * re-enters the least-recently-visited one rather than dying. Burst START
 * times stay in lockstep across walkers even though burst lengths differ.
 *
 * Under prefers-reduced-motion the walk is off: one static frame.
 */
---

<canvas class="post__hero hero-voronoi" aria-hidden="true"></canvas>

<style>
  /* Reserve the banner's space before the script sizes the bitmap */
  .hero-voronoi {
    aspect-ratio: 3 / 1;
  }
</style>

<script>
  import { Delaunay } from "d3-delaunay";

  // Deterministic RNG so the composition is stable across visits
  function mulberry32(a: number) {
    return function () {
      a |= 0;
      a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  const ASPECT = 3; // logical space is ASPECT x 1
  const N = 150;
  const WALKERS = 5;
  const WALK_EVERY = 30; // seconds between synchronized walk bursts
  const BURST_MIN = 3; // hops per burst: random in [BURST_MIN, BURST_MAX]
  const BURST_MAX = 7;
  const HOP_GAP = 1.0; // seconds between the hops of one burst

  function init(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const rand = mulberry32(7);

    // Clustered candidate seeds (like a PCA projection of embeddings),
    // thinned to a minimum separation so no degenerate sliver cells
    const cands: any[] = [];
    const centers = Array.from({ length: 8 }, () => [
      0.15 + rand() * (ASPECT - 0.3),
      0.12 + rand() * 0.76,
    ]);
    for (const [cx, cy] of centers) {
      const n = 22 + Math.floor(rand() * 16);
      for (let i = 0; i < n; i++) {
        const gx = (rand() + rand() + rand() - 1.5) / 1.5;
        const gy = (rand() + rand() + rand() - 1.5) / 1.5;
        cands.push({ x: cx + gx * 0.26, y: cy + gy * 0.18 });
      }
    }
    for (let i = 0; i < 90; i++) cands.push({ x: rand() * ASPECT, y: rand() });
    const seeds: any[] = [];
    for (const c of cands) {
      if (seeds.length >= N) break;
      c.x = Math.min(ASPECT - 0.01, Math.max(0.01, c.x));
      c.y = Math.min(0.99, Math.max(0.01, c.y));
      if (seeds.every((s) => Math.hypot(s.x - c.x, s.y - c.y) > 0.085)) seeds.push(c);
    }
    for (const s of seeds) {
      s.hue = rand() * 360;
      s.light = 87 + rand() * 7;
      s.sat = 35 + rand() * 35;
      // satellite dots (ops) at fixed offsets from the seed
      s.dots = Array.from({ length: 2 + Math.floor(rand() * 3) }, () => [
        (rand() - 0.5) * 0.09,
        (rand() - 0.5) * 0.06,
      ]);
    }

    // Static logical-space geometry: adjacency for the walk, areas for the
    // initial selection
    const points = seeds.map((s) => [s.x, s.y]);
    const delaunayL = Delaunay.from(points);
    const vorL = delaunayL.voronoi([0, 0, ASPECT, 1]);
    const byArea = seeds
      .map((s, i) => {
        const poly = vorL.cellPolygon(i);
        let a = 0;
        if (poly)
          for (let k = 0; k < poly.length - 1; k++)
            a += poly[k][0] * poly[k + 1][1] - poly[k + 1][0] * poly[k][1];
        return { i, area: Math.abs(a) / 2 };
      })
      .sort((p, q) => q.area - p.area);

    // Walkers start on large, well-separated cells. Bursts are a single
    // GLOBAL event (nextBurstAt in tick), so synchronization is structural;
    // per-walker state is just the current cell and the hops left.
    const walkers: any[] = [];
    for (const { i } of byArea) {
      if (walkers.length >= WALKERS) break;
      const s = seeds[i];
      if (
        walkers.every((w) => Math.hypot(seeds[w.cell].x - s.x, seeds[w.cell].y - s.y) > 0.55)
      )
        walkers.push({ cell: i, burstLeft: 0, tNext: 0 });
    }
    // visited: cell -> time of (most recent) visit
    const visited = new Map<number, number>();
    for (const w of walkers) visited.set(w.cell, 0);

    // Sub-partition seeds per cell, generated lazily: offsets are FRACTIONS
    // of the cell's half-extents so one recipe fits any cell it lands on
    const subCache = new Map<number, any[]>();
    const subFor = (i: number) => {
      let sub = subCache.get(i);
      if (!sub) {
        const r = mulberry32(1000 + i);
        sub = Array.from({ length: 8 }, () => ({
          fx: (r() - 0.5) * 1.7,
          fy: (r() - 0.5) * 1.7,
          light: 66 + r() * 22,
          // ops in this sub-cell: the first sits on the sub-seed itself,
          // which is inside its own Voronoi region by definition, so every
          // sub-partition is guaranteed at least one dot
          dots: [
            [0, 0],
            ...Array.from({ length: 1 + Math.floor(r() * 3) }, () => [
              (r() - 0.5) * 0.28,
              (r() - 0.5) * 0.28,
            ]),
          ],
        }));
        subCache.set(i, sub);
      }
      return sub;
    };

    const step = (w: any, t: number) => {
      const taken = new Set<number>();
      for (const o of walkers) {
        if (o !== w) taken.add(o.cell);
      }
      const nbrs = [...delaunayL.neighbors(w.cell)].filter((c) => c >= 0 && !taken.has(c));
      if (nbrs.length === 0) return; // fully boxed in; try again next round
      const unvisited = nbrs.filter((c) => !visited.has(c));
      let next: number;
      if (unvisited.length) {
        next = unvisited[Math.floor(Math.random() * unvisited.length)];
      } else {
        // dead end: re-enter the least-recently-visited neighbor
        nbrs.sort((a, b) => (visited.get(a) ?? 0) - (visited.get(b) ?? 0));
        next = nbrs[0];
      }
      w.cell = next;
      visited.set(next, t);
    };

    // The static base layer (tessellation + dots) renders once per size
    // into an offscreen canvas; per-frame work is compositing only
    const base = document.createElement("canvas");
    const bctx = base.getContext("2d")!;
    let cssW = 0;
    let cssH = 0;
    let pxPts: number[][] = [];
    let vorPx: any = null;

    const tracePoly = (c: CanvasRenderingContext2D, poly: number[][]) => {
      c.beginPath();
      c.moveTo(poly[0][0], poly[0][1]);
      for (const [x, y] of poly) c.lineTo(x, y);
      c.closePath();
    };

    // Op dots share one style everywhere (base layer, sub-partitions, the
    // redraw pass over sub-cells)
    const drawDots = (
      c: CanvasRenderingContext2D,
      x: number,
      y: number,
      offsets: number[][],
      sx: number,
      sy: number,
      hue: number,
    ) => {
      c.fillStyle = `hsl(${hue} 70% 45% / 0.85)`;
      for (const [dx, dy] of offsets) {
        c.beginPath();
        c.arc(x + dx * sx, y + dy * sy, 1.4, 0, Math.PI * 2);
        c.fill();
      }
    };

    function resize() {
      const w = canvas.clientWidth || canvas.parentElement?.clientWidth || 0;
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      cssW = w;
      cssH = w / ASPECT;
      canvas.style.height = cssH + "px";
      canvas.width = base.width = Math.round(w * dpr);
      canvas.height = base.height = Math.round(cssH * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      bctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (cssW < 10) return;

      const S = cssW / ASPECT;
      pxPts = points.map(([x, y]) => [x * S, y * S]);
      vorPx = Delaunay.from(pxPts).voronoi([0, 0, cssW, cssH]);

      bctx.clearRect(0, 0, cssW, cssH);
      bctx.lineJoin = "round";
      for (let i = 0; i < seeds.length; i++) {
        const poly = vorPx.cellPolygon(i);
        if (!poly) continue;
        const s = seeds[i];
        tracePoly(bctx, poly);
        bctx.fillStyle = `hsl(${s.hue} ${s.sat}% ${s.light}%)`;
        bctx.fill();
        bctx.strokeStyle = "#3a3a3a";
        bctx.lineWidth = 0.8;
        bctx.stroke();
      }
      for (let i = 0; i < seeds.length; i++)
        drawDots(bctx, pxPts[i][0], pxPts[i][1], seeds[i].dots, S, S, seeds[i].hue);
      draw();
    }

    // Draw one cell's bold outline + sub-partition
    function drawSelection(i: number) {
      const poly = vorPx.cellPolygon(i);
      if (!poly) return;
      const s = seeds[i];
      let minx = 1e9, miny = 1e9, maxx = -1e9, maxy = -1e9;
      for (const [x, y] of poly) {
        minx = Math.min(minx, x);
        miny = Math.min(miny, y);
        maxx = Math.max(maxx, x);
        maxy = Math.max(maxy, y);
      }
      const cx = pxPts[i][0];
      const cy = pxPts[i][1];
      const hw = (maxx - minx) / 2;
      const hh = (maxy - miny) / 2;
      const subSeeds = subFor(i);
      const sp = subSeeds.map((u) => [cx + u.fx * hw, cy + u.fy * hh]);

      ctx.save();
      tracePoly(ctx, poly);
      ctx.clip();
      const sub = Delaunay.from(sp).voronoi([minx, miny, maxx, maxy]);
      for (let k = 0; k < sp.length; k++) {
        const q = sub.cellPolygon(k);
        if (!q) continue;
        tracePoly(ctx, q);
        ctx.fillStyle = `hsl(${s.hue} 55% ${subSeeds[k].light}%)`;
        ctx.fill();
        ctx.strokeStyle = "#3a3a3a";
        ctx.lineWidth = 0.6;
        ctx.stroke();
      }
      // each sub-partition's own ops, drawn after every sub-cell fill so a
      // neighboring fill can't paint over a dot near a shared edge
      for (let k = 0; k < sp.length; k++)
        drawDots(ctx, sp[k][0], sp[k][1], subSeeds[k].dots, hw, hh, s.hue);
      // the sub-cells also painted over the base layer's op dots: redraw
      // every dot that can land in this cell (still clipped to it)
      const S = cssW / ASPECT;
      const pad = 0.1 * S; // max dot offset from its seed
      for (let j = 0; j < seeds.length; j++) {
        const [jx, jy] = pxPts[j];
        if (jx < minx - pad || jx > maxx + pad || jy < miny - pad || jy > maxy + pad)
          continue;
        drawDots(ctx, jx, jy, seeds[j].dots, S, S, seeds[j].hue);
      }
      ctx.restore();
      tracePoly(ctx, poly);
      ctx.strokeStyle = "#1a1a1a";
      ctx.lineWidth = 1.8;
      ctx.stroke();
    }

    function draw() {
      ctx.clearRect(0, 0, cssW, cssH);
      ctx.drawImage(base, 0, 0, cssW, cssH);
      ctx.lineJoin = "round";
      for (const w of walkers) drawSelection(w.cell);
    }

    // resize() ends with draw(), so every size path is also a render path:
    // the explicit call paints now if layout already happened, and the
    // ResizeObserver repaints on size changes. RO alone is NOT enough for
    // first paint — its callbacks ride the rendering pipeline, which
    // embedded panes can suppress entirely — so the tick below also
    // re-checks the size (the same reason the ticks come from a worker).
    resize();
    new ResizeObserver(resize).observe(canvas);

    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced) return; // walk off: the static frame above is all there is

    // Pause while scrolled past — but only trust the observer when the
    // document is genuinely visible: embedded panes can report "hidden"
    // while displaying the page, and there the observer may never fire.
    let inView = true;
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
    }).observe(canvas);

    const t00 = performance.now();
    let nextBurstAt = WALK_EVERY; // one global clock: all walks start together
    const tick = () => {
      if (canvas.clientWidth !== cssW) resize(); // RO-independent size tracking
      if (cssW < 10) return; // not laid out yet
      if (!inView && document.visibilityState === "visible") return;
      const t = (performance.now() - t00) / 1000;
      if (t >= nextBurstAt) {
        nextBurstAt = t + WALK_EVERY;
        for (const w of walkers) {
          w.burstLeft = BURST_MIN + Math.floor(Math.random() * (BURST_MAX - BURST_MIN + 1));
          w.tNext = t; // first hop lands this tick
        }
      }
      let hopped = false;
      for (const w of walkers) {
        if (w.burstLeft > 0 && t >= w.tNext) {
          step(w, t);
          w.burstLeft--;
          w.tNext = t + HOP_GAP;
          hopped = true;
        }
      }
      // fully idle between hops: draw only when a hop just landed
      if (hopped) draw();
    };
    // Worker-driven ticks, not rAF or a main-thread interval: embedded
    // panes can report the document "hidden" even while displaying it,
    // which suppresses rAF and clamps main-thread timers to ~1Hz. Worker
    // timers aren't visibility-throttled. 250ms granularity is plenty for
    // events on 1s hop beats and keeps idle wakeups cheap.
    const worker = new Worker(
      URL.createObjectURL(
        new Blob(["setInterval(() => postMessage(0), 250);"], {
          type: "application/javascript",
        }),
      ),
    );
    worker.onmessage = tick;
  }

  document.querySelectorAll<HTMLCanvasElement>("canvas.hero-voronoi").forEach(init);
</script>
