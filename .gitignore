# build output
dist/
.output/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# astro
.astro/

# local claude settings
.claude/settings.local.json

# posts: each folder may hold private working files (notes, research docs);
# only the published post.md, its optional Hero.astro (animated hero — see
# blog/[...slug].astro), and its assets are ever tracked
content/posts/**
!content/posts/*/
!content/posts/*/post.md
!content/posts/*/Hero.astro
!content/posts/*/assets/
!content/posts/*/assets/**
