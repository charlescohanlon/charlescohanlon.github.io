---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, getEntry, render } from "astro:content";

const page = await getEntry("pages", "research");
if (!page) throw new Error("Missing content/pages/research.md");
const { Content } = await render(page);
const hasIntro = !!page.body?.trim();

const projects = (await getCollection("research")).sort((a, b) => {
  const aTime = a.data.date?.valueOf() ?? 0;
  const bTime = b.data.date?.valueOf() ?? 0;
  return bTime - aTime;
});
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <header class="page__title-wrap mb-6">
    <h1 class="page__title m-0">{page.data.title}</h1>
  </header>

  {
    hasIntro && (
      <div class="prose prose-sm max-w-none mb-8">
        <Content />
      </div>
    )
  }

  {
    projects.length === 0 ? (
      <p class="text-sm text-muted">
        No projects yet. Add Markdown files in <code>content/research/</code>.
      </p>
    ) : (
      <div class="flex flex-col gap-5">
        {projects.map((p) => (
          <article class="border border-rule rounded-md p-5 flex flex-col sm:flex-row sm:gap-6">
            {p.data.image && (
              <img
                src={p.data.image}
                alt={p.data.title}
                class="w-full h-40 sm:w-48 sm:h-auto sm:max-h-36 object-cover rounded mb-3 sm:mb-0 shrink-0 self-start"
              />
            )}
            <div class="flex flex-col flex-1">
              <h2 class="font-semibold mt-0">{p.data.title}</h2>
              <p class="text-sm text-muted mt-2 leading-relaxed flex-1">
                {p.data.description}
              </p>
              {p.data.presentations.length > 0 && (
                <ul class="mt-4 pt-2 border-t border-rule space-y-2">
                  {p.data.presentations.map((pres) => (
                    <li class="text-sm text-muted">
                      {pres.type && (
                        <span class="mr-1.5 align-middle inline-block text-[10px] uppercase tracking-wide font-semibold border border-rule rounded px-1.5 py-0.5">
                          {pres.type}
                        </span>
                      )}
                      <span class="font-medium">{pres.title}</span>
                      <div class="mt-2.5">
                        {pres.authors && pres.authors.length > 0 && (
                          <>
                            {pres.authors.map((author, i) => (
                              <>
                                {i > 0 && ", "}
                                {author === "Charles O'Hanlon" ? (
                                  <strong>{author}</strong>
                                ) : (
                                  author
                                )}
                              </>
                            ))}
                            {". "}
                          </>
                        )}
                        <span class="italic">{pres.venue}</span>, {pres.year}
                      </div>
                    </li>
                  ))}
                </ul>
              )}
              {p.data.funding && (
                <p class="text-xs text-muted mt-3">{p.data.funding}</p>
              )}
              <p class="text-sm mt-3 flex gap-3">
                {p.data.link && (
                  <a href={p.data.link} target="_blank" rel="noopener">
                    [Link]
                  </a>
                )}
                {p.data.code && (
                  <a href={p.data.code} target="_blank" rel="noopener">
                    [Code]
                  </a>
                )}
                {p.data.presentations
                  .filter((pres) => pres.pdf)
                  .map((pres) => (
                    <a href={pres.pdf} target="_blank" rel="noopener">
                      [{pres.type ?? "PDF"}]
                    </a>
                  ))}
              </p>
            </div>
          </article>
        ))}
      </div>
    )
  }
</BaseLayout>
