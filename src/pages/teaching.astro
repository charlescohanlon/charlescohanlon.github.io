---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getEntry, render } from "astro:content";

const page = await getEntry("pages", "teaching");
if (!page) throw new Error("Missing content/pages/teaching.md");
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <header class="page__title-wrap mb-6">
    <h1 class="page__title m-0">{page.data.title}</h1>
  </header>

  <div class="prose prose-sm max-w-none">
    <Content />
  </div>
</BaseLayout>
