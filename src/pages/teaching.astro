---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getEntry, render } from "astro:content";

const page = await getEntry("pages", "teaching");
if (!page) throw new Error("Missing content/pages/teaching.md");
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <header class="page__title-wrap mb-6">
    <h1 class="page__title m-0">{page.data.title}</h1>
  </header>

  <div class="prose prose-sm max-w-none teaching-content">
    <Content />
  </div>
</BaseLayout>

<style>
  /* The italic institution/date line under each role heading is the
     heading's subtitle — tuck it under the h2 instead of letting it float
     mid-way between heading and body on full paragraph margins. */
  .teaching-content :global(h2 + p:has(> em:only-child)) {
    margin-top: -0.625rem;
  }
</style>
