---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import { formatDate } from "@/lib/dates";

const about = await getEntry("pages", "about");
if (!about) throw new Error("Missing content/pages/about.md");
const { Content } = await render(about);

const news = (await getCollection("news")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const newsItems = await Promise.all(
  news.map(async (item) => ({
    date: item.data.date,
    Body: (await render(item)).Content,
  }))
);

---

<BaseLayout title={about.data.title} description={about.data.description}>
  <article>
    <header class="page__title-wrap mb-6">
      <h1 class="page__title m-0">{about.data.title}</h1>
    </header>

    <div class="prose prose-sm max-w-none">
      <Content />
    </div>

    {
      newsItems.length > 0 && (
        <section class="mt-10">
          <h2 class="text-xl font-bold mb-3 pb-2 border-b border-rule">
            News
          </h2>
          <ul class="text-sm space-y-2 not-prose">
            {newsItems.map(({ date, Body }) => (
              <li class="flex gap-3">
                <span class="text-muted whitespace-nowrap w-24 shrink-0">
                  {formatDate(date)}
                </span>
                <div class="[&>p]:m-0">
                  <Body />
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>
