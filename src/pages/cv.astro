---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getEntry, render } from "astro:content";

const page = await getEntry("pages", "cv");
if (!page) throw new Error("Missing content/pages/cv.md");
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <article class="cv">
    <header class="page__title-wrap mb-6">
      <h1 class="page__title m-0">{page.data.title}</h1>
    </header>

    <div class="prose prose-sm max-w-none prose-headings:font-bold prose-headings:text-heading prose-h2:text-2xl prose-h2:mt-8 prose-h2:mb-3 prose-h2:pb-2 prose-h2:border-b prose-h2:border-rule prose-h3:text-base prose-h3:mt-4 prose-h3:mb-1 prose-ul:my-2 prose-li:my-1">
      <Content />
    </div>
  </article>
</BaseLayout>
