---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import { postSlug } from "@/lib/posts";
import { formatDate } from "@/lib/dates";

const page = await getEntry("pages", "blog");
if (!page) throw new Error("Missing content/pages/blog.md");
const { Content } = await render(page);
const hasIntro = !!page.body?.trim();

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <header class="page__title-wrap mb-6">
    <h1 class="page__title m-0">{page.data.title}</h1>
  </header>

  {
    hasIntro && (
      <div class="prose prose-sm max-w-none mb-8">
        <Content />
      </div>
    )
  }

  {
    posts.length === 0 ? (
      <p class="text-sm text-muted">
        Coming soon.
      </p>
    ) : (
      <ul class="space-y-6">
        {posts.map((post) => (
          <li>
            <h2 class="text-lg font-semibold">
              <a href={`/blog/${postSlug(post.id)}`}>{post.data.title}</a>
            </h2>
            <p class="text-xs text-muted mt-1">
              {formatDate(post.data.date)}
            </p>
            {post.data.description && (
              <p class="text-sm text-muted mt-1">
                {post.data.description}
              </p>
            )}
            {post.data.tags.length > 0 && (
              <p class="text-xs mt-2 flex flex-wrap gap-2 text-muted">
                {post.data.tags.map((tag) => (
                  <span class="px-2 py-0.5 rounded-full border border-rule">
                    {tag}
                  </span>
                ))}
              </p>
            )}
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
