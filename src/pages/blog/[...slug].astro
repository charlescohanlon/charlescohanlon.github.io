---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import ImageLightbox from "@/components/ImageLightbox.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import { getSettings } from "@/config";
import { postSlug } from "@/lib/posts";
import { formatDate } from "@/lib/dates";

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: postSlug(post.id) },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);
const site = await getSettings();

// A post opts into an animated hero by shipping a `Hero.astro` next to its
// post.md — everything about that hero (component, generator scripts, the
// static fallback in assets/) stays in the post's own folder, so each
// future animated hero is isolated with its post. The content loader only
// collects post.{md,mdx}, so these components never leak into the
// collection. Matched by the post's real on-disk folder (from filePath),
// which both sides share verbatim — no slug round-trip to keep in sync.
const heroModules = import.meta.glob<{ default: any }>(
  "../../../content/posts/*/Hero.astro",
  { eager: true },
);
const postFolder = post.filePath?.split("/").at(-2);
const heroPath = Object.keys(heroModules).find(
  (p) => p.split("/").at(-2) === postFolder,
);
const Hero = heroPath ? heroModules[heroPath].default : null;
const hasHero = Boolean(Hero || post.data.hero);
---

<BaseLayout title={post.data.title} description={post.data.description} hideSidebar>
  {/* Title block, then the hero across the whole content container, then
      the article column — the hero separates title from abstract, so the
      header's rule only draws when there is no hero. */}
  <header
    class:list={[
      "post__header max-w-2xl mx-auto",
      hasHero ? "post__header--with-hero" : "mb-10",
    ]}
  >
        <h1 class="text-3xl font-bold mt-0 mb-3">{post.data.title}</h1>
        {
          post.data.description && (
            <p class="post__subtitle text-base text-muted mb-4">
              {post.data.description}
            </p>
          )
        }
        <p class="text-sm text-muted">
          <span class="text-ink font-medium">{site.author.name}</span>
          <span aria-hidden="true"> · </span>
          {formatDate(post.data.date, "long")}
          {post.data.updated && (
            <span> · updated {formatDate(post.data.updated, "long")}</span>
          )}
        </p>
        {
          post.data.tags.length > 0 && (
            <p class="text-xs mt-3 flex flex-wrap gap-2 text-muted">
              {post.data.tags.map((tag) => (
                <span class="px-2 py-0.5 rounded-full border border-rule">
                  {tag}
                </span>
              ))}
            </p>
          )
        }
  </header>

  {/* An animated Hero.astro takes precedence; the frontmatter image is the
      static rendering — used directly when there's no component, and as the
      no-JS fallback when there is. At the ≥80rem breakout the hero is
      76rem wide (72rem container + 2 * --toc-overhang). */}
  {Hero && <Hero />}
  {
    post.data.hero &&
      (Hero ? (
        <noscript>
          <Image
            src={post.data.hero}
            alt=""
            class="post__hero"
            widths={[768, 1536, 2400]}
            sizes="(min-width: 80rem) 76rem, (min-width: 72rem) 72rem, 100vw"
          />
        </noscript>
      ) : (
        <Image
          src={post.data.hero}
          alt=""
          class="post__hero"
          widths={[768, 1536, 2400]}
          sizes="(min-width: 80rem) 76rem, (min-width: 72rem) 72rem, 100vw"
        />
      ))
  }

  <div class="post-shell">
    {/* The GFM footnotes section's visually-hidden heading isn't a section
        of the post (its notes render in the margins here anyway). */}
    <TableOfContents
      headings={headings.filter((h) => h.slug !== "footnote-label")}
    />
    <article class="post-shell__article max-w-2xl mx-auto">
      <div class="post__body lightbox-source prose prose-sm sm:prose-base max-w-none">
        <Content />
      </div>

      <p class="mt-12 text-sm">
        <a href="/blog">← Back to blog</a>
      </p>
    </article>
  </div>
  <ImageLightbox />
</BaseLayout>

<style is:global>
  /* Room above a heading when the TOC jumps to it — clears the sticky
     masthead. */
  .post__body :is(h2, h3, h4, h5, h6) {
    scroll-margin-top: calc(var(--masthead-height) + 1.5rem);
  }

  .post__header {
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 1.5rem;
  }

  /* When a hero follows the title block, the banner is the separator */
  .post__header--with-hero {
    border-bottom: none;
    padding-bottom: 0;
  }

  /* Decorative hero banner between the title block and the abstract,
     spanning the whole content container. Baked on white like the post
     figures, so it gets the same dark-mode treatment. Its wide-layout
     breakout lives in the 80rem block below, with the post-shell grid. */
  .post__hero {
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
    border: 1px solid var(--color-rule);
    margin: 2rem 0 2.75rem;
    filter: var(--baked-image-filter);
  }

  .post__subtitle {
    font-family: var(--font-caption);
    font-style: italic;
  }

  /* Figures: the remark plugin wraps image paragraphs in <figure> with a
     <figcaption>. Captions open with a bold "Figure N." / "Table N." label
     and sit after the image (figures) or before it (tables). */
  .post__body figure {
    margin: 2.25rem 0 2.5rem;
  }
  .post__body figure img {
    margin: 0 auto;
  }
  /* Post images are baked on white; flipped in dark mode (see global.css). */
  .post__body img {
    filter: var(--baked-image-filter);
  }
  /* The --caption-* tokens are shared with the lightbox's enlarged-view
     caption, which copies this DOM and must stay visually identical to it. */
  .post__body figcaption {
    display: block;
    font-family: var(--font-caption);
    font-weight: 400;
    font-size: var(--caption-font-size);
    line-height: var(--caption-line-height);
    color: var(--color-muted);
    margin: 0.75rem auto 0;
    max-width: 40rem;
  }
  .post__body figcaption strong {
    color: var(--color-ink);
  }
  /* Captions above their image (tables): flip the margin */
  .post__body .figure--caption-first figcaption {
    margin: 0 auto 0.75rem;
  }

  /* KaTeX defaults to 1.21em, which towers over the prose — render math at
     exactly the surrounding text's size. */
  .post__body .katex {
    font-size: 1em;
  }

  /* Display math: keep wide equations scrollable instead of overflowing. */
  .post__body .katex-display {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.25rem 0;
  }

  /* Reference entries ("[N] Author. ...") in smaller, tighter type.
     The :not() guard stops the styling at the Citation section, since ~
     matches every following sibling, not just entries under References. */
  .post__body #references ~ p:not(#citation ~ p) {
    font-size: 0.875rem;
    line-height: 1.55;
    margin: 0.625rem 0;
  }

  /* Footnotes (built by rehype-sidenotes): each reference carries a copy
     of its note in a .sidenote span, hidden site-wide by default (see
     global.css), so narrow screens get a conventional footnotes appendix.
     The wide-layout block below floats the copy into the right margin
     beside its reference instead. */
  .post__body .sidenote {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-muted);
  }
  .post__body .sidenote .katex-display,
  .post__body section.footnotes .katex-display {
    margin: 0.5em 0;
  }
  .post__body .sidenote::before {
    content: attr(data-note);
    position: relative;
    top: -0.35rem;
    padding-right: 0.25rem;
    font-size: 0.75rem;
    color: var(--color-accent);
  }

  /* Footnotes appendix: small type above a rule. */
  .post__body section.footnotes {
    margin-top: 3rem;
    border-top: 1px solid var(--color-rule);
    padding-top: 1rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .post__body section.footnotes p {
    margin: 0.25rem 0;
  }

  /* The wide post layout: a centered column with the TOC in the left
     gutter and footnotes as sidenotes in the right one. 80rem is
     Tailwind's xl breakpoint — the TOC shows itself with xl:block, so
     keep this query in sync with it. */
  @media (min-width: 80rem) {
    /* The 13rem TOC overflows its gutter column this far past the
       container's left edge; the hero breaks out by the same amount on
       both sides so its left edge lines up with the sticky menu. */
    .post__hero {
      --toc-overhang: 2rem;
      width: calc(100% + 2 * var(--toc-overhang));
      margin-inline: calc(-1 * var(--toc-overhang));
    }

    .post-shell {
      /* --post-column matches the article's max-w-2xl */
      --post-column: 42rem;
      --gutter-gap: 2.5rem;
      --sidenote-width: 12rem;
      display: grid;
      grid-template-columns:
        minmax(0, 1fr) minmax(0, var(--post-column)) minmax(0, 1fr);
      column-gap: var(--gutter-gap);
      align-items: start;
    }
    .post-shell__article {
      grid-column: 2;
      width: 100%;
    }
    /* Float into the right margin: the negative right margin cancels the
       float's footprint so the paragraph text doesn't wrap around it. */
    .post__body .sidenote {
      display: block;
      float: right;
      clear: right;
      width: var(--sidenote-width);
      margin-right: calc(-1 * var(--sidenote-width) - var(--gutter-gap));
      margin-left: var(--gutter-gap);
      margin-top: 0.3rem;
      margin-bottom: 1.25rem;
    }
    .post__body section.footnotes {
      display: none;
    }
    /* The number's jump target is hidden here, so don't offer the link */
    .post__body sup.footnote-ref {
      pointer-events: none;
    }
  }
</style>
